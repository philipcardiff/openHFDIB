FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

surfaceFile "Geom.fms";
checkForGluedMesh 1;

/* ============ GLOBAL SIZE FIELD ============ */
maxCellSize  0.0045;
minCellSize  0.001;

/* ============ NEAR-SURFACE (all patches) ============ */
boundaryCellSize                    0.0013;
boundaryCellSizeRefinementThickness 0.0018;

