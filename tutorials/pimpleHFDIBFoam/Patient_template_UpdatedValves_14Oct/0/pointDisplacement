FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       pointVectorField;
    location    "0";
    object      pointDisplacement;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    WALL
    {
        // Value overwritten by the movingVentricle motion solver
        type    fixedValue;
        value   uniform (0 0 0);
    }
    // TOP
    // {
    //     // Value overwritten by the movingVentricle motion solver
    //     type    fixedValue;
    //     value   uniform (0 0 0);
    // }
    INLET
    {
        type    fixedValue;
        value   uniform (0 0 0);
    }
    OUTLET
    {
        type    fixedValue;
        value   uniform (0 0 0);
    }
}

