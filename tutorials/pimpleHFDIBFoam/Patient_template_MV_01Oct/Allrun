#!/usr/bin/env bash
set -euo pipefail

# Source OpenFOAM environment and RunFunctions
. "${WM_PROJECT_DIR:-$HOME/OpenFOAM/OpenFOAM-v2412}/etc/bashrc"
. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

app=$(getApplication)

# Detect processor count (env PROCS overrides decomposeParDict; default 1)
nFromDict=$(foamDictionary system/decomposeParDict -entry numberOfSubdomains -value 2>/dev/null || echo 1)
NP="${PROCS:-$nFromDict}"
[[ -z "${NP// }" ]] && NP=1

# Mesh if none exists
if [[ ! -d constant/polyMesh ]]; then
  ./Allmesh
fi

# Optional warm-up for dynamicCode
if grep -q "libs (.*lib.*dynamicCode.*)" system/controlDict 2>/dev/null; then
  cp system/controlDict system/controlDict.bak
  trap 'mv -f system/controlDict.bak system/controlDict' EXIT
  foamDictionary system/controlDict -entry stopAt -set writeNow >/dev/null
  runApplication "$app" -noFunctionObjects
  mv -f system/controlDict.bak system/controlDict
  trap - EXIT
fi

# Run (parallel if NP > 1)
if (( NP > 1 )); then
  if [[ "$NP" != "$nFromDict" ]]; then
    foamDictionary system/decomposeParDict -entry numberOfSubdomains -set "$NP" >/dev/null
  fi
  runApplication decomposePar -force
  runApplication "$app" -parallel
  runApplication reconstructPar -latestTime
else
  runApplication "$app"
fi

# Optional post-processing
[[ -f system/sampleDict ]] && runApplication postProcess -func sample
