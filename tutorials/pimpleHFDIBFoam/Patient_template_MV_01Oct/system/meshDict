FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceFile "Geom.fms";

checkForGluedMesh 1;

/* ================== GLOBAL SIZE FIELD ================== */
maxCellSize  0.0065;   
minCellSize  0.004;   

/* ================== BOUNDARY SIZE FIELD ================== */

boundaryCellSize 0.003;                    
boundaryCellSizeRefinementThickness 0.003;   

/* ================== BOUNDARY LAYERS ================== */

boundaryLayers
{
    enable true;
    nLayers                  2;
    allowDiscontinuity      false;
    nSmoothNormals          30;
    nSmoothThickness        15;
    nGrow                   3;
    maxFaceThicknessRatio   0.4;
    minLayerThickness       0.004;
    maxCellAspectRatio      40;

    // ---- per-patch overrides ----
    patchBoundaryLayers
    {
        INLET  
        { 
            nLayers 0; 
        }
        OUTLET 
        { 
            nLayers 0; 
        }

        // Use your exact wall patch name(s) here; regex allowed
        WALL
        {
            nLayers                 6;
            maxFirstLayerThickness  0.004;
            thicknessRatio          1.3;
            allowDiscontinuity      false;
        }
    }
}

