FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     pimpleHFDIBFoam;

libs            ( "libfvMotionSolvers.so" "libmeshTools.so" "libmovingVentricleFvMotionSolver.so" "libHFDIBM.so" );

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

adjustTimeStep  no;

deltaT          0.00025;

writeControl    timeStep;

writeInterval   20;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


